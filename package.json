{
  "name": "@nocker-inc/prompton",
  "type": "module",
  "version": "0.1.0",
  "description": "CLI for https://prompton.io",
  "homepage": "https://prompton.io",
  "license": "MIT",
  "author": "shigurenimo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nocker-inc/prompton-cli.git"
  },
  "keywords": [
    "prompton"
  ],
  "bin": {
    "prompton": "dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "generate": "gql.tada generate-output",
    "check": "tsgo --noEmit",
    "format": "biome check --write --unsafe ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "^7.0.0-dev.20260314.1",
    "tsdown": "^0.21.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@0no-co/graphqlsp": "^1.15.2",
    "@hono/zod-validator": "^0.7.6",
    "@opentui/core": "^0.1.87",
    "gql.tada": "^1.9.0",
    "graphql": "^16.13.1",
    "hono": "^4.12.8",
    "zod": "^4.3.6"
  }
}
